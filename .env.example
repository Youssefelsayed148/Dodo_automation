# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- LLM (text + vision). Leave the key empty to run fully offline with mocks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# TEXT_PROVIDER / VISION_PROVIDER default to "anthropic" when a key is set, else "mock".
# TEXT_PROVIDER=mock
# VISION_PROVIDER=mock

# --- Manual mode (ChatGPT copy/paste, no paid API). 1 = on, 0 = off, empty = auto
# (auto = on when ANTHROPIC_API_KEY is empty and IMAGE_PROVIDER is mock). Settings page can override it.
MANUAL_MODE=

# --- Image provider: mock | openai | gemini  (pick the winner of the comparison harness)
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional cost overrides (USD): image = per image, text = per 1M tokens
# COST_TABLE=openai:gpt-image-1=0.04,anthropic:claude-opus-5-5:in=4,anthropic:claude-opus-5-5:out=20

# --- Storage
DATABASE_URL=sqlite:///data/app.db
# DATA_DIR=./data

# --- Server (v1 is local-only; keep 127.0.0.1)
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Google Drive (optional). OAuth "Desktop app" client from Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend (read by Vite). Empty = same origin via the dev proxy.
VITE_API_BASE=
